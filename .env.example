# =============================================================================
# Supabase
# =============================================================================
# URL y anon key: Project Settings > API en el dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: SOLO se usa en el servidor (webhook, admin client). Nunca
# exponerla al cliente ni prefijarla con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Anthropic (agente de IA)
# =============================================================================
ANTHROPIC_API_KEY=

# =============================================================================
# Google OAuth (Google Calendar)
# =============================================================================
# Client ID/secret de un proyecto en Google Cloud Console con la API de
# Calendar habilitada y una pantalla de consentimiento OAuth configurada.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con un "Authorized redirect URI" registrado en
# Google Cloud Console, ej: https://tu-dominio.com/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# =============================================================================
# Cifrado de credenciales en BD (AES-256-GCM, ver lib/crypto.ts)
# =============================================================================
# 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# =============================================================================
# App
# =============================================================================
# URL publica donde corre la app (usada para construir callback URLs, links en
# emails, etc). En Vercel: la URL del deployment/dominio custom.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email de la cuenta del DUEÑO DE LA PLATAFORMA (no de un negocio cliente):
# quien haya iniciado sesion con este email exacto puede entrar en
# /admin/invites y generar codigos de invitacion para /signup, que esta
# cerrado (solo servicio de pago). Ver lib/auth/platform-admin.ts.
PLATFORM_ADMIN_EMAIL=

# =============================================================================
# Nota sobre credenciales de WhatsApp
# =============================================================================
# phone_number_id, waba_id, access_token, verify_token y app_secret de
# WhatsApp Cloud API NO van aqui: se guardan por organizacion en la tabla
# `whatsapp_configs` (cifrados) desde la pagina /integraciones, porque la app
# es multi-tenant (cada negocio conecta su propio numero de WhatsApp).

# =============================================================================
# Twilio (WhatsApp Sandbox -- solo desarrollo/pruebas)
# =============================================================================
# A diferencia de WhatsApp Cloud API (arriba), el Sandbox de Twilio es un
# numero COMPARTIDO por todos los desarrolladores, sin config por
# organizacion -- por eso estas 3 credenciales SI van en variables de
# entorno (una sola cuenta de Twilio para todo el deployment). Ver
# lib/twilio/resolve-org.ts y lib/twilio/send-message.ts.
# Consola de Twilio > Account Info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero del Sandbox de WhatsApp de Twilio, ej: +14155238886 (con o sin el
# prefijo "whatsapp:", ambos funcionan).
TWILIO_PHONE_NUMBER=

# Opcional: id de la organizacion (tabla `organizations`) a la que se le
# asignan los mensajes que llegan por Twilio. Si se omite, y hay EXACTAMENTE
# una organizacion en la base de datos, se usa esa automaticamente (caso
# tipico de un solo desarrollador probando localmente). Si hay cero o mas de
# una organizacion y esta variable no esta seteada, los mensajes de Twilio
# se descartan (con log de advertencia) en vez de asignarse a la organizacion
# equivocada.
TWILIO_ORGANIZATION_ID=
